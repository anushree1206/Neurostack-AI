# NeuroStack AI - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── OpenAI API ──────────────────────────────────────────────
# Required: at least one API key must be set
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=              # Custom endpoint (optional)

# Alternative key format (takes precedence if set)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Model Selection ─────────────────────────────────────────
# Set OPENAI_MODEL to override all agent models at once,
# or configure individually below.
# OPENAI_MODEL=gpt-4o-mini
# ORCHESTRATOR_MODEL=gpt-4o-mini
# AGENT_MODEL=gpt-4o-mini
# META_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────────────────────
# Used by docker-compose; change if customizing Postgres creds
PGUSER=agentuser
PGPASSWORD=agentpass
PGDATABASE=agentdb
# DATABASE_URL is set automatically in docker-compose.yml

# ── Application ─────────────────────────────────────────────
# false = full dashboard with all endpoints (default)
# true  = strict 5-endpoint mode for assignment submission
STRICT_API_FIVE_ENDPOINTS=false

# Max completion tokens for synthesis agent (default 12000)
# SYNTHESIS_MAX_COMPLETION_TOKENS=12000
